# ---------------------------------------------------------------
# Copy this file to .env and paste your Gemini API key.
# ---------------------------------------------------------------

# Main Gemini model
LLM_MODEL=gemini-3.5-flash-lite

# Used automatically when the main model is busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash

# Google Gemini API key (free) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
